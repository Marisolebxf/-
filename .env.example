# gkx-lumen 工作区环境变量模板
# 用法：cp .env.example .env，按你的本地环境填写
# 重要：.env 不入 git（已在 .gitignore），每人本地配置
# ★ 路径唯一真源：本文件 → GKX_ROOT；paths.yaml 只是展开表

# ============================================================
# 必填项
# ============================================================

# 工作区根目录（绝对路径，建议与 GitLab group 同名）
# Windows 示例: E:/gkx-lumen
# Mac/Linux 示例: ~/work/gkx-lumen
GKX_ROOT=E:/gkx-lumen

# ============================================================
# 选填项（按需）
# ============================================================

# 设计/招标文档根（如果你有访问权限）
# 这是私有路径，每人不同；agent 通过 ${GKX_DOCS_ROOT} 引用
# Windows 示例: e:/实施/2025/智谱-深圳国科信
# 留空 = agent 不读本地设计文档（仅用 agent-delivery/bid-reference）
GKX_DOCS_ROOT=

# GitLab 凭据（用于 bootstrap 脚本批量 clone / push）
# 推荐使用 personal access token (PAT)，权限 = read_repository + write_repository
# 申请：https://gitlab.htmisoft.net/-/user_settings/personal_access_tokens
GKX_GITLAB_USER=
GKX_GITLAB_TOKEN=

# 默认 GitLab group（一般不需要改，除非你 fork 到了私有 group）
GKX_GITLAB_GROUP=gkx-lumen
GKX_GITLAB_BASE=https://gitlab.htmisoft.net

# Cursor / AI 相关（如需要）
# CURSOR_BACKGROUND_AGENT_QUOTA=4

# ============================================================
# 飞书 Open Platform（多维表格 Bitable · Phase 0 人类看板）
# 见 agent-delivery/feishu-bitable-integration.md
# ============================================================
FEISHU_APP_ID=cli_aad8fb07f4b81bdd
FEISHU_APP_SECRET=HAOz2kIZpBUUzDZSGl7dyf8N3yCG7cfE

# ============================================================
# 飞书项目（Scrum · 待企业审批通过后启用，见 feishu-project-integration.md）
# ============================================================
FEISHU_PROJECT_PLUGIN_ID=
FEISHU_PROJECT_PLUGIN_SECRET=
FEISHU_PROJECT_USER_KEY=
