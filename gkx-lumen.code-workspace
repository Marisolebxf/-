{
  "//": "Cursor / VS Code multi-root workspace for gkx-lumen (RFC-002 §6)",
  "//1": "用法：File -> Open Workspace from File -> 选这个文件",
  "//2": "相对路径都基于本文件位置（gkx-orchestration/），故跨机器跨盘符通用",
  "//3": "若某子仓本机未 clone，Cursor 会显示 'folder missing' warning，跑 bootstrap 即可",
  "//4": "settings 排除 node_modules/target/.venv 等，避免索引爆炸",

  "folders": [
    { "name": "gkx-orchestration  (主仓 / agent-delivery / RFC / scripts)",  "path": "." },
    { "name": "demo-ui-science  (前端 demo / 科技信息展示系统 / Arco 试点真源)",  "path": "../repos/demo-ui-science" },
    { "name": "demo-algo-ent-analysis  (Python 算法 demo / 企业维度 / NebulaGraph 真源)",  "path": "../repos/demo-algo-ent-analysis" },
    { "name": "dataease  (BI 工具 fork)",  "path": "../repos/dataease" },
    { "name": "demo-ui-system-test  (前端 / 系统级实验沙箱)",  "path": "../repos/demo-ui-system-test" },
    { "name": "lumen-svc-platform  (Java 后端正式仓 / 覆盖两系统)",  "path": "../repos/lumen-svc-platform" },
    { "name": "lumen-ui-science-pc  (科技信息展示系统-PC 正式前端)",  "path": "../repos/lumen-ui-science-pc" },
    { "name": "lumen-ui-science-mobile  (科技信息展示系统-移动正式前端)",  "path": "../repos/lumen-ui-science-mobile" },
    { "name": "lumen-ui-admin  (管理后台正式前端 / lumen-ui-admin)",  "path": "../repos/lumen-ui-admin" },
    { "name": "demo-svc-platform  (Java 后端 demo / gkx-innov + helm 模板)",  "path": "../repos/demo-svc-platform" },
    { "name": "demo-algo-science  (Python 算法 demo / 创新监测 P1-P9)",  "path": "../repos/demo-algo-science" },
    { "name": "demo-ui-topic  (前端 demo / 科技专题服务系统)",  "path": "../repos/demo-ui-topic" },
    { "name": "demo-admin-ui  (管理后台 demo / 权限体系 UI)",  "path": "../repos/demo-admin-ui" },
    { "name": "lumen-ui-topic  (专题服务正式前端 / lumen-ui-topic)",  "path": "../repos/lumen-ui-topic" },
    { "name": "demo-svc-topic-py  (Python 后端 demo / 专题服务检索)",  "path": "../repos/demo-svc-topic-py" },
    { "name": "lumen-etl-es-py  (Python ETL / DWD→Elasticsearch)",  "path": "../repos/lumen-etl-es-py" },
    { "name": "worktrees  (并行 task 分支区)",  "path": "../worktrees" }
  ],

  "settings": {
    "files.exclude": {
      "**/.git": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/target": true,
      "**/.venv": true,
      "**/venv": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.mvn": true,
      "**/.idea": true,
      "**/.gradle": true,
      "**/.next": true,
      "**/.nuxt": true,
      "**/coverage": true,
      "**/*.pyc": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/target": true,
      "**/.venv": true,
      "**/venv": true,
      "**/__pycache__": true,
      "**/coverage": true,
      "**/*.lock": true,
      "**/package-lock.json": true,
      "**/yarn.lock": true,
      "**/pnpm-lock.yaml": true,
      "**/.git/**": true
    },
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/build/**": true,
      "**/target/**": true,
      "**/.venv/**": true,
      "**/__pycache__/**": true
    },
    "git.scanRepositories": [
      ".",
      "../repos/demo-ui-science",
      "../repos/demo-algo-ent-analysis",
      "../repos/dataease",
      "../repos/demo-ui-system-test",
      "../repos/lumen-svc-platform",
      "../repos/lumen-ui-science-pc",
      "../repos/lumen-ui-science-mobile",
      "../repos/lumen-ui-admin",
      "../repos/demo-svc-platform",
      "../repos/demo-algo-science",
      "../repos/demo-ui-topic",
      "../repos/demo-admin-ui",
      "../repos/lumen-ui-topic",
      "../repos/demo-svc-topic-py",
      "../repos/lumen-etl-es-py",
      "../worktrees"
    ],
    "git.autoRepositoryDetection": true,
    "files.encoding": "utf8",
    "files.eol": "\n",
    "[markdown]": {
      "editor.wordWrap": "on"
    },
    "[yaml]": {
      "editor.tabSize": 2
    },
    "java.compile.nullAnalysis.mode": "automatic",
    "iis.activeFolder": "gkx-orchestration  (主仓 / agent-delivery / RFC / scripts)"
  },

  "extensions": {
    "recommendations": [
      "vue.volar",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "redhat.java",
      "vscjava.vscode-maven",
      "ms-python.python",
      "ms-python.vscode-pylance",
      "redhat.vscode-yaml",
      "yzhang.markdown-all-in-one"
    ]
  }
}
