{
  "//": "全量多根工作区 —— 仅跨仓大重构/全库检索时使用。日常请用 workspaces/*.code-workspace 瘦配方。",
  "//1": "用法：File -> Open Workspace from File",
  "//2": "folders[].name 必须短英文，禁止括号/斜杠/长中文（否则路径拼显示名导致 Unable to open）",
  "//3": "若某子仓本机未 clone，Cursor 会显示 folder missing，跑 bootstrap 即可",
  "//4": "降 Token：优先 workspaces/README.md 中的瘦工作区",
  "//5": "不含 dataease（开源 BI fork，非日常多根；见 repo-registry）",

  "folders": [
    { "name": "gkx-orchestration", "path": "." },
    { "name": "demo-ui-science", "path": "../repos/demo-ui-science" },
    { "name": "demo-algo-ent-analysis", "path": "../repos/demo-algo-ent-analysis" },
    { "name": "demo-ui-system-test", "path": "../repos/demo-ui-system-test" },
    { "name": "lumen-svc-platform", "path": "../repos/lumen-svc-platform" },
    { "name": "lumen-ui-science-pc", "path": "../repos/lumen-ui-science-pc" },
    { "name": "lumen-ui-science-mobile", "path": "../repos/lumen-ui-science-mobile" },
    { "name": "lumen-ui-admin", "path": "../repos/lumen-ui-admin" },
    { "name": "demo-svc-platform", "path": "../repos/demo-svc-platform" },
    { "name": "demo-algo-science", "path": "../repos/demo-algo-science" },
    { "name": "demo-ui-topic", "path": "../repos/demo-ui-topic" },
    { "name": "demo-admin-ui", "path": "../repos/demo-admin-ui" },
    { "name": "lumen-ui-topic", "path": "../repos/lumen-ui-topic" },
    { "name": "demo-svc-topic-py", "path": "../repos/demo-svc-topic-py" },
    { "name": "lumen-etl-es-py", "path": "../repos/lumen-etl-es-py" },
    { "name": "lumen-algo-py", "path": "../repos/lumen-algo-py" },
    { "name": "lumen-algo-platform", "path": "../repos/lumen-algo-platform" },
    { "name": "worktrees", "path": "../worktrees" }
  ],

  "settings": {
    "files.exclude": {
      "**/.git": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/target": true,
      "**/.venv": true,
      "**/venv": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.mvn": true,
      "**/.idea": true,
      "**/.gradle": true,
      "**/.next": true,
      "**/.nuxt": true,
      "**/coverage": true,
      "**/*.pyc": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/target": true,
      "**/.venv": true,
      "**/venv": true,
      "**/__pycache__": true,
      "**/coverage": true,
      "**/*.lock": true,
      "**/package-lock.json": true,
      "**/yarn.lock": true,
      "**/pnpm-lock.yaml": true,
      "**/.git/**": true
    },
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/build/**": true,
      "**/target/**": true,
      "**/.venv/**": true,
      "**/__pycache__/**": true
    },
    "git.scanRepositories": [
      ".",
      "../repos/demo-ui-science",
      "../repos/demo-algo-ent-analysis",
      "../repos/demo-ui-system-test",
      "../repos/lumen-svc-platform",
      "../repos/lumen-ui-science-pc",
      "../repos/lumen-ui-science-mobile",
      "../repos/lumen-ui-admin",
      "../repos/demo-svc-platform",
      "../repos/demo-algo-science",
      "../repos/demo-ui-topic",
      "../repos/demo-admin-ui",
      "../repos/lumen-ui-topic",
      "../repos/demo-svc-topic-py",
      "../repos/lumen-etl-es-py",
      "../repos/lumen-algo-py",
      "../repos/lumen-algo-platform",
      "../worktrees"
    ],
    "git.autoRepositoryDetection": true,
    "files.encoding": "utf8",
    "files.eol": "\n",
    "[markdown]": {
      "editor.wordWrap": "on"
    },
    "[yaml]": {
      "editor.tabSize": 2
    },
    "java.compile.nullAnalysis.mode": "automatic",
    "iis.activeFolder": "gkx-orchestration",
    "java.completion.collapseCompletionItems": false
  },

  "extensions": {
    "recommendations": [
      "vue.volar",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "redhat.java",
      "vscjava.vscode-maven",
      "ms-python.python",
      "ms-python.vscode-pylance",
      "redhat.vscode-yaml",
      "yzhang.markdown-all-in-one"
    ]
  }
}
