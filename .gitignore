# gkx-lumen 主仓 .gitignore (RFC-002 §5.3 黑名单)

# ============================================================
# 1. 本地环境配置（每人不同，禁止入库）
# ============================================================
.env
.env.local
.env.*.local

# ============================================================
# 2. 业务子仓 & worktree（在新根但独立 git）
# ============================================================
# repos/ 由 bootstrap 脚本 clone 各业务子仓（每个有自己的 .git），主仓不追踪
/repos/
# worktrees/ 由 worktree-helper 创建（属于各子仓的 worktree），主仓不追踪
/worktrees/
# projects/ 为 ppt-master 等本地出片工作区（SVG/PPTX/备份），主仓不追踪
/projects/

# ============================================================
# 3. 构建产物
# ============================================================
node_modules/
dist/
build/
target/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# ============================================================
# 4. IDE / 系统
# ============================================================
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
.codebuddy/
# ============================================================
# 5. 调试 / 日志 / 临时文件
# ============================================================
# as-built runner 本地验收产物（调通脚本用；正式记录走 test-records/evidence）
agent-delivery/qa/as-built/runs/
# 历史误用：曾有人手填 --run-dir 到 qa/runs/；真源仅 as-built/runs/（run-scripts.mjs 默认）
agent-delivery/qa/runs/
# 政策 E7 QA 冒烟工作副本（handoff / 缺陷包为验收真源；2026-09-10 淮政玮）
agent-delivery/agent-handoffs/政策模块-E7/evidence/
terminals/
*.log
debug-*.txt
.draft.md
*.local.md
_tmp/
tmp/
# Office 锁文件永不入库；agent-delivery/metrics/**/*.xlsx 允许进仓（2026-08-22 淮政玮）
~$*

# ============================================================
# 6. 二进制 dump 例外（按 RFC-002 §13 Q5 允许在仓根暂存）
# ============================================================
# .admin-ui.b64    # ← 不 ignore，按 Q5 决议入库
# 2gkxx.sql.b64    # ← 不 ignore，按 Q5 决议入库

# ============================================================
# 7. Cursor / AI 临时
# ============================================================
.cursor-tutor/
.cursor-logs/
.superpowers/

# ============================================================
# 8. 老根迁移期间的临时校验文件
# ============================================================
migration-diff-*.txt
rsync-dryrun-*.log

# K8s 本地 secret（只用 secret.example.yaml 模板）
deploy/feishu-sync/k8s/secret.yaml

# ============================================================
# 9. Agent 运行时临时（2026-11-08 追加）
# ============================================================
.tmp/
.local/t09-*/
.playwright-cli/
.trae/documents/
_local/
logs/
nul; cleaned
