{
  "//": "瘦工作区：专题服务前端。",
  "folders": [
    {
      "name": "gkx-orchestration",
      "path": ".."
    },
    {
      "name": "lumen-ui-topic",
      "path": "../../repos/lumen-ui-topic"
    },
    {
      "name": "lumen-ui-topic-mobile",
      "path": "../../repos/lumen-ui-topic-mobile"
    },
    {
      "name": "demo-ui-topic",
      "path": "../../repos/demo-ui-topic"
    },
    {
      "name": "jx-topic-backend",
      "path": "../../jx-tech-topic/iticsci-tech-topic-backend"
    },
    {
      "name": "jx-topic-frontend",
      "path": "../../jx-tech-topic/iticsci-tech-topic-frontend"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/.git": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/target": true,
      "**/.venv": true,
      "**/venv": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.mvn": true,
      "**/.idea": true,
      "**/.gradle": true,
      "**/coverage": true,
      "**/*.pyc": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/target": true,
      "**/.venv": true,
      "**/__pycache__": true,
      "**/coverage": true,
      "**/*.lock": true,
      "**/package-lock.json": true,
      "**/yarn.lock": true,
      "**/pnpm-lock.yaml": true,
      "**/.git/**": true
    },
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/target/**": true,
      "**/.venv/**": true,
      "**/__pycache__/**": true
    },
    "git.scanRepositories": [
      "..",
      "../../repos/lumen-ui-topic",
      "../../repos/lumen-ui-topic-mobile",
      "../../repos/demo-ui-topic",
      "../../jx-tech-topic/iticsci-tech-topic-backend",
      "../../jx-tech-topic/iticsci-tech-topic-frontend"
    ],
    "git.autoRepositoryDetection": true,
    "files.encoding": "utf8",
    "files.eol": "\n",
    "[markdown]": {
      "editor.wordWrap": "on"
    },
    "[yaml]": {
      "editor.tabSize": 2
    }
  }
}
