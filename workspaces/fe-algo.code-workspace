{
  "//": "瘦工作区：算法前端正式交付。勿加 Python algo / admin / science UI。",
  "folders": [
    { "name": "gkx-orchestration", "path": ".." },
    { "name": "lumen-ui-algo-apiview", "path": "../../repos/lumen-ui-algo-apiview" }
  ],
  "settings": {
    "files.exclude": {
      "**/.git": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/target": true,
      "**/.venv": true,
      "**/venv": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.mvn": true,
      "**/.idea": true,
      "**/.gradle": true,
      "**/coverage": true,
      "**/*.pyc": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/target": true,
      "**/.venv": true,
      "**/__pycache__": true,
      "**/coverage": true,
      "**/*.lock": true,
      "**/package-lock.json": true,
      "**/yarn.lock": true,
      "**/pnpm-lock.yaml": true,
      "**/.git/**": true
    },
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/target/**": true,
      "**/.venv/**": true,
      "**/__pycache__/**": true
    },
    "git.scanRepositories": [
      "..",
      "../../repos/lumen-ui-algo-apiview"
    ],
    "git.autoRepositoryDetection": true,
    "files.encoding": "utf8",
    "files.eol": "\n",
    "[markdown]": { "editor.wordWrap": "on" },
    "[yaml]": { "editor.tabSize": 2 }
  }
}
