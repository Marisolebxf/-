{
  "//": "瘦工作区：Python 算法 / ETL。勿加全部 UI。",
  "folders": [
    { "name": "gkx-orchestration", "path": ".." },
    { "name": "demo-algo-science", "path": "../../repos/demo-algo-science" },
    { "name": "demo-algo-ent-analysis", "path": "../../repos/demo-algo-ent-analysis" },
    { "name": "demo-svc-topic-py", "path": "../../repos/demo-svc-topic-py" },
    { "name": "lumen-etl-es-py", "path": "../../repos/lumen-etl-es-py" },
    { "name": "lumen-algo-py", "path": "../../repos/lumen-algo-py" }
  ],
  "settings": {
    "files.exclude": {
      "**/.git": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/target": true,
      "**/.venv": true,
      "**/venv": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.mvn": true,
      "**/.idea": true,
      "**/.gradle": true,
      "**/coverage": true,
      "**/*.pyc": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/target": true,
      "**/.venv": true,
      "**/__pycache__": true,
      "**/coverage": true,
      "**/*.lock": true,
      "**/package-lock.json": true,
      "**/yarn.lock": true,
      "**/pnpm-lock.yaml": true,
      "**/.git/**": true
    },
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/target/**": true,
      "**/.venv/**": true,
      "**/__pycache__/**": true
    },
    "git.scanRepositories": [
      "..",
      "../../repos/demo-algo-science",
      "../../repos/demo-algo-ent-analysis",
      "../../repos/demo-svc-topic-py",
      "../../repos/lumen-etl-es-py"
    ],
    "git.autoRepositoryDetection": true,
    "files.encoding": "utf8",
    "files.eol": "\n",
    "[markdown]": { "editor.wordWrap": "on" },
    "[yaml]": { "editor.tabSize": 2 }
  }
}
