// 参考片段：复制到各 *.code-workspace 的 "settings" 节（JSONC，workspace 文件本身不 import）
{
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/target": true,
    "**/.venv": true,
    "**/venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mvn": true,
    "**/.idea": true,
    "**/.gradle": true,
    "**/.next": true,
    "**/.nuxt": true,
    "**/coverage": true,
    "**/*.pyc": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/target": true,
    "**/.venv": true,
    "**/venv": true,
    "**/__pycache__": true,
    "**/coverage": true,
    "**/*.lock": true,
    "**/package-lock.json": true,
    "**/yarn.lock": true,
    "**/pnpm-lock.yaml": true,
    "**/.git/**": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/target/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true
  },
  "files.encoding": "utf8",
  "files.eol": "\n",
  "[markdown]": { "editor.wordWrap": "on" },
  "[yaml]": { "editor.tabSize": 2 }
}
