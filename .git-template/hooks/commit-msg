#!/usr/bin/env bash
# commit-msg hook (RFC-002 §10 R11 mitigation)
# 强约束 commit message 格式（按 team-onboarding §5 红线 #5）：
#   必须以下列之一开头：
#     [agent:<role>]   例：[agent:frontend-agent] xxx
#     [human:<name>]   例：[human:hzw] xxx
#     [RFC]            评审落地
#     docs(...)        Conventional Commits 文档类
#     feat(...)        新功能
#     fix(...)         修复
#     chore(...)       杂项
#     refactor(...)    重构
#     test(...)        测试
#     style(...)       格式
#     perf(...)        性能
#     ci(...)          CI/CD
#     build(...)       构建系统
#     revert(...)      撤销
#   或：Merge / Revert（git 默认）
#   或：以 # 开头（comment，会被忽略）

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

MSG_FILE="$1"
FIRST_LINE=$(grep -v '^#' "$MSG_FILE" | head -1)

if [[ -z "$FIRST_LINE" ]]; then
    # 空 commit message 让 git 自己处理
    exit 0
fi

# 允许的前缀正则
allowed_prefixes=(
    '^\[agent:[a-z-]+\]'
    '^\[human:[a-zA-Z0-9_-]+\]'
    '^\[RFC[^]]*\]'
    '^docs(\([^)]+\))?:'
    '^feat(\([^)]+\))?:'
    '^fix(\([^)]+\))?:'
    '^chore(\([^)]+\))?:'
    '^refactor(\([^)]+\))?:'
    '^test(\([^)]+\))?:'
    '^style(\([^)]+\))?:'
    '^perf(\([^)]+\))?:'
    '^ci(\([^)]+\))?:'
    '^build(\([^)]+\))?:'
    '^revert(\([^)]+\))?:'
    '^Merge '
    '^Revert '
    '^Initial commit'
)

for pattern in "${allowed_prefixes[@]}"; do
    if echo "$FIRST_LINE" | grep -qE "$pattern"; then
        # 通过
        # 额外检查：subject 长度 ≤ 100 字符（warning，不 fail）
        subject_len=${#FIRST_LINE}
        if [[ $subject_len -gt 100 ]]; then
            echo -e "${YELLOW}⚠️  commit subject 长度 $subject_len > 100 字符（建议 ≤ 72，最大 100）${NC}"
        fi
        exit 0
    fi
done

# 没有任何前缀匹配
echo ""
echo -e "${RED}❌ commit message 格式不符规约${NC}"
echo -e "${RED}   首行：$FIRST_LINE${NC}"
echo ""
echo -e "${YELLOW}必须以以下之一开头：${NC}"
echo "   [agent:<role>]   AI 产出，例：[agent:frontend-agent] xxx"
echo "   [human:<name>]   人类产出，例：[human:hzw] xxx"
echo "   [RFC...]         RFC 评审落地"
echo "   docs/feat/fix/chore/refactor/test/style/perf/ci/build/revert(...): 标准 Conventional Commits"
echo ""
echo -e "${YELLOW}如需绕过：git commit --no-verify (仅在确认无误时使用)${NC}"
exit 1
