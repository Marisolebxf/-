#!/usr/bin/env bash
# pre-commit hook (RFC-002 §10 R11 mitigation)
# 拦截：
#   1. 高危正则（secret / password / API key / private key 等）
#   2. .env 局部文件被意外提交
#   3. node_modules / dist 等构建产物被意外提交
#   4. 大文件（> 10 MB）警告

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

# 获取本次提交的文件列表
staged_files=$(git diff --cached --name-only --diff-filter=ACM)

if [[ -z "$staged_files" ]]; then
    exit 0
fi

violations=0

# ============================================================
# Check 1: 高危正则（secret / password / token / key）
# ============================================================
echo -e "${YELLOW}[pre-commit] 扫描高危正则 ...${NC}"

# 仅扫描文本文件
text_files=()
while IFS= read -r f; do
    if [[ -f "$f" ]] && file "$f" 2>/dev/null | grep -qE '(text|ASCII|UTF-8|empty)'; then
        text_files+=("$f")
    fi
done <<< "$staged_files"

if [[ ${#text_files[@]} -gt 0 ]]; then
    # 危险关键词
    dangerous_patterns=(
        'password\s*=\s*["\047][^"\047]{4,}'
        'api[_-]?key\s*=\s*["\047][^"\047]{8,}'
        'secret\s*=\s*["\047][^"\047]{8,}'
        '-----BEGIN (RSA |DSA |EC |OPENSSH )?PRIVATE KEY-----'
        'AKIA[0-9A-Z]{16}'                                # AWS access key
        'xox[baprs]-[0-9a-zA-Z]{10,}'                      # Slack token
        'ghp_[a-zA-Z0-9]{36}'                              # GitHub PAT
        'glpat-[a-zA-Z0-9_-]{20}'                          # GitLab PAT
    )
    
    for pattern in "${dangerous_patterns[@]}"; do
        for f in "${text_files[@]}"; do
            if grep -E -l "$pattern" "$f" > /dev/null 2>&1; then
                echo -e "  ${RED}❌ 高危内容 in $f${NC}"
                echo -e "     pattern: $pattern"
                violations=$((violations + 1))
            fi
        done
    done
fi

# ============================================================
# Check 2: .env 局部文件被提交（.env / .env.local / .env.production 等）
# ============================================================
echo -e "${YELLOW}[pre-commit] 扫描 .env 局部文件 ...${NC}"
while IFS= read -r f; do
    if [[ "$f" == ".env" || "$f" == ".env.local" || "$f" =~ \.env\.[a-z]+$ ]] && [[ "$f" != ".env.example" ]]; then
        echo -e "  ${RED}❌ 禁止提交 .env 局部文件：$f${NC}"
        violations=$((violations + 1))
    fi
done <<< "$staged_files"

# ============================================================
# Check 3: 构建产物
# ============================================================
echo -e "${YELLOW}[pre-commit] 扫描构建产物 ...${NC}"
forbidden_dirs=('node_modules/' 'dist/' 'build/' 'target/' '.venv/' '__pycache__/')
while IFS= read -r f; do
    for d in "${forbidden_dirs[@]}"; do
        if [[ "$f" == "$d"* || "$f" == */"$d"* ]]; then
            echo -e "  ${RED}❌ 禁止提交构建产物：$f${NC}"
            violations=$((violations + 1))
        fi
    done
done <<< "$staged_files"

# ============================================================
# Check 4: 大文件（> 10 MB，warning）
# ============================================================
echo -e "${YELLOW}[pre-commit] 扫描大文件 ...${NC}"
while IFS= read -r f; do
    if [[ -f "$f" ]]; then
        size=$(wc -c < "$f")
        if [[ $size -gt 10485760 ]]; then  # 10 MB
            size_mb=$(echo "scale=1; $size / 1048576" | bc 2>/dev/null || echo "$((size / 1048576))")
            echo -e "  ${YELLOW}⚠️  大文件 (${size_mb}MB)：$f${NC}"
            # 仅 warning，不 fail
        fi
    fi
done <<< "$staged_files"

# ============================================================
# 结果
# ============================================================
if [[ $violations -gt 0 ]]; then
    echo ""
    echo -e "${RED}❌ pre-commit 拦截 ($violations 项违规)${NC}"
    echo -e "${YELLOW}→ 修复后再 commit，或 git commit --no-verify 强制（仅在你确认安全时）${NC}"
    exit 1
fi

echo -e "${GREEN}✅ pre-commit 通过${NC}"
exit 0
