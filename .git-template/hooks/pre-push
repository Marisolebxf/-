#!/usr/bin/env bash
# pre-push hook (RFC-002 §10 R11 mitigation)
# 拦截：
#   1. force push 到 main / master / release/* 分支
#   2. push 到老 GitLab group (SZCGKX) 的警告（M4+ 应拒绝）

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

remote="$1"
url="$2"

# ============================================================
# Check 1: force push 到 protected 分支拦截
# ============================================================
# git 在 stdin 给我们：<local_ref> <local_sha> <remote_ref> <remote_sha>
# 如果 local_sha 不是 remote_sha 的祖先 = force push

protected_patterns=(
    'refs/heads/main$'
    'refs/heads/master$'
    'refs/heads/release/'
)

while read -r local_ref local_sha remote_ref remote_sha; do
    # 跳过创建分支 / 删除分支
    [[ "$local_sha" == "0000000000000000000000000000000000000000" ]] && continue
    [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]] && continue
    
    # 是否 protected 分支
    is_protected=false
    for p in "${protected_patterns[@]}"; do
        if echo "$remote_ref" | grep -qE "$p"; then
            is_protected=true
            break
        fi
    done
    
    if $is_protected; then
        # 检查是否 force push：remote_sha 应该是 local_sha 的祖先
        if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
            echo ""
            echo -e "${RED}❌ 拒绝 force push 到 protected 分支：$remote_ref${NC}"
            echo -e "${RED}   local:  $local_sha${NC}"
            echo -e "${RED}   remote: $remote_sha${NC}"
            echo ""
            echo -e "${YELLOW}如需强制：git push --no-verify --force（仅在团队管理者同意时使用）${NC}"
            exit 1
        fi
    fi
done

# ============================================================
# Check 2: 推到老 GitLab group 警告
# ============================================================
if echo "$url" | grep -qE 'gitlab.htmisoft.net[:/]SZCGKX/'; then
    echo ""
    echo -e "${YELLOW}⚠️  你正在 push 到老 GitLab group SZCGKX${NC}"
    echo -e "${YELLOW}   URL: $url${NC}"
    echo -e "${YELLOW}   M4 起老根应仅接 bugfix（详见 RFC-002 §9 冻结分级）${NC}"
    echo -e "${YELLOW}   按 Enter 继续，Ctrl+C 取消...${NC}"
    read -r < /dev/tty || true
fi

echo -e "${GREEN}✅ pre-push 通过${NC}"
exit 0
