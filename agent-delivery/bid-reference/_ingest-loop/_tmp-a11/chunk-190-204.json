              "A194": "191",
              "B194": "",
              "C194": "",
              "D194": "",
              "E194": "项目资源管理",
              "F194": "提供项目合作资源库，为项目培育提供合作资源管理，支持为项目自动关联合适的合作资源。需提供的功能包括：资源标签管理、合作资源管理等。",
              "G194": "智能服务集群",
              "H194": "科技专题服务系统",
              "I194": "科技专题项目管理",
              "J194": "项目资源管理",
              "K194": "资源标签管理",
              "L194": "标签目录管理",
              "M194": "标签目录管理的具体功能包括目录结构设计、目录维护。\n（1）目录结构设计\n支持创建多级标签目录（例如，“专家资源/技术领域/人工智能”），以树形结构清晰地展现标签间的层级与归属关系。\n（2）目录维护\n支持对标签目录进行新增、编辑、移动、删除等操作，确保目录结构可根据业务发展灵活调整。",
              "N194": ""
            }
          },
