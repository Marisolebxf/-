  "diagnosis": {
    "symptom": "科技全域态势关键词检索：输入后提示「检索服务不可用」；搜索框右侧同时出现两个清除用的 ✗。",
    "reproduction": [
      "打开科技全域态势（真实轨 USE_MOCK=false）",
      "在顶部「关键词检索」输入任意关键字",
      "观察输入框右侧清除控件数量与下拉候选面板提示文案"
    ],
    "root_cause": "双✗：SituationFilterBar 使用 type=search 的原生清除钮 + 自定义 IconClose 清除按钮叠层。检索不可用：前端在 result.degraded===true 或请求抛错时展示该文案；Java SituationFactorSearchController 在 Feign 调 search-py /internal/gkx-search/factors 失败时返回 degraded=true；Python 在 ES ping/初始化失败时抛 RealDataUnavailable→503。本机无法直连 10.50.69.111 复测线上是否仍为下游失败。",
    "counter_evidence": [
      "需规序号4要求输入关键字后触发检索并生成候选，不是显示服务不可用",
      "诚实降级契约要求下游不可用时才显示「检索服务不可用」，不得回落伪结果",
      "双✗与 degraded 文案是两个独立表面；前者可单仓前端修复"
    ],
    "requirement_refs": [
      "agent-delivery/bid-reference/srs/02-科技信息展示系统/科技发展态势/科技全域态势.md#搜索要素定位-序号4"
    ],
    "impact_scope": [
      "lumen-ui-science-pc：SituationFilterBar.vue 搜索框 type/清除钮",
      "若线上仍 degraded：lumen-svc-platform Feign + lumen-topic-py factor_search + ES 可用性（可能升 L/跨仓）"
    ]
  },
  "plan": {
    "change_scope": [
      "先修 lumen-ui-science-pc 双清除钮（type=text 或隐藏原生 search cancel，保留单一自定义清除）",
      "进入开发后用可达环境复测 factors/search；若仍 degraded 再判定是否扩到 Java/Python"
    ],
    "non_goals": [
      "不回落本地伪候选冒充真实检索",
      "不新建 ES 索引补齐论文/专利/项目类目",
      "未经确认不把环境故障当代码补丁轮次"
    ],
    "verification_plan": [
      "fix：输入关键词后仅 1 个清除 ✗",
      "regression：清空按钮仍可清空；候选面板/历史仍可用",
      "integration：可达环境下 POST factors/search 返回 degraded=false 且有候选，或明确环境 blocker"
    ],
    "rollback_plan": [
      "回滚前端 fix 分支提交"
    ],
    "data_access": false
  },
