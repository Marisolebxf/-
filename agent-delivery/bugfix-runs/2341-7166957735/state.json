  "diagnosis": {
    "symptom": "深圳创新监测报告（生成报告导出的 Word/PDF）在正式章节之外出现成段开发向文案：Doris 表名清单（ads_institution_profile 等）、「专利授权口径实测不可靠，不出数」「创新价值/排名/四维分/贡献度等字段在数仓无对应列，报告中一律不出现」「城市对比只呈现真实原始计数，不形成能力分、名次或年份预测」等内部实现说明，以「数据口径」区块和分节段落形式进入用户报告。",
    "reproduction": [
      "打开科技发展态势 → 深圳创新监测页",
      "点击「生成报告」，下载/打开导出的报告文件",
      "报告开头出现「数据口径」区块，第 1-4 条均为数仓表名、口径不可靠说明等开发向文案；第一节「创新载体综合展示」段落里也出现「创新价值、综合排名、四维分与贡献度在数据源数仓无对应列，报告中不呈现、不推算」"
    ],
    "root_cause": "src/views/situation/shenzhen-innovation/index.vue 的 buildSzInnovationReport() 把开发阶段的诚实性备注原样写进 dataNotes（渲染成报告「数据口径」区块）与分节 paragraphs。这些内容面向开发/验收（Doris 表名、数仓列缺口、口径不可靠判断），不属于 SRS seq 135 要求的用户报告内容（对比结果、竞争力分析、发展建议）。同族缺陷 7165535282（全球创新城市政策建议开发性文案）已按同样思路修复（fb63422）。",
    "counter_evidence": [
      "SRS seq 135（报告生成与导出）只要求对比结果、排名情况、竞争力分析和发展建议，PDF/Word 导出；不含数据源表名或开发口径说明",
      "同仓 7165535282 修复已确立口径：开发性文案不进用户报告 DOM/导出内容",
      "诚实性约束保留：数据缺口不在报告里伪造数值，只是不再用开发语言表述"
    ],
    "requirement_refs": [
      "agent-delivery/bid-reference/srs/02-科技信息展示系统/科技发展态势/深圳创新监测.md#报告生成与导出·序号135"
    ],
    "impact_scope": [
      "lumen-ui-science-pc/src/views/situation/shenzhen-innovation/index.vue（buildSzInnovationReport 的 dataNotes 与分节 paragraphs）",
      "新增深圳报告文案自检测试"
    ]
  },
  "plan": {
    "change_scope": [
      "lumen-ui-science-pc/src/views/situation/shenzhen-innovation/index.vue：buildSzInnovationReport() 移除 dataNotes 中的 Doris 表名清单、「专利授权口径实测不可靠不出数」「数仓无对应列不呈现」等开发向条目；分节 paragraphs 移除「创新价值、综合排名、四维分与贡献度在数据源数仓无对应列…」「城市对比只呈现真实原始计数，不形成能力分、名次或年份预测」等内部实现说明；替换为面向业务用户的一句数据说明（口径保留诚实性：不虚构缺口数值，但用业务语言）",
      "新增 src/views/situation/shenzhen-innovation/szReportCopy.test.mjs：断言报告组装源码不再包含开发性短语（表名/数仓/口径不可靠等），且保留 SRS seq 135 所需章节",
      "不改动 reportExport.ts 渲染逻辑与其它态势页报告"
    ],
    "non_goals": [
      "不改深圳页面 DOM 展示（页面上的角标/说明条不在本缺陷范围）",
      "不改后端接口与数据口径",
      "不为报告伪造排名/评分等缺失数据"
    ],
    "verification_plan": [
      "node 新增自检测试退出 0",
      "pnpm type-check 通过",
      "pnpm build 通过",
      "本地渲染报告 HTML 目检无开发性文案"
    ],
    "rollback_plan": [
      "单文件改动 + 新增测试，git revert 单 commit 即可回滚"
    ],
