  "diagnosis": {
    "symptom": "技术发展跟踪的“地理分布图展示”中，区域标记的蓝色圆点压住区域名称首字，导致北京市显示成“京市”、天津市显示成“津市”、石家庄市显示成“家庄市”等，名称展示不全。",
    "reproduction": [
      "进入技术发展跟踪页面并完成/打开一次技术评估结果",
      "切换到“地理分布图展示”",
      "查看地图区域标记，区域名称首字被蓝点遮挡"
    ],
    "root_cause": "ResultDashboard 的简单区域标记使用 soft-workbench__map-marker-dot + soft-workbench__map-marker-label；点采用 absolute+z-index 定位，而通用 marker 的 label 没有定义水平偏移、display 或独立背景，标签从 marker 原点开始，首字落入圆点覆盖范围。",
    "counter_evidence": [
      "区域名称数据已存在于 marker DOM 中，不是接口或字段缺失",
      "问题只在简单 marker 样式出现；object marker 有 flex/gap 规则时可正常分列",
      "飞书截图 2253 中多个城市名都以相同方式丢失首字"
    ],
    "requirement_refs": [
      "agent-delivery/bid-reference/srs/02-科技信息展示系统/科技发展态势/技术发展跟踪.md#地理分布图展示-序号49",
      "Feishu 2253 缺陷截图：区域名称被标点遮挡展示不全"
    ],
    "impact_scope": [
      "lumen-ui-science-pc 技术发展跟踪 ResultDashboard 地图简单 marker 布局",
      "不涉及地图数据、评估结果、接口和交互语义"
    ]
  },
  "plan": {
    "change_scope": [
      "lumen-ui-science-pc/src/views/situation/tracking/styles/demo-tech-tracking.css"
    ],
    "non_goals": [
      "不改图例、点位位置、缩放、点击下钻和技术评估数据",
      "不改天地图底图或公共地图组件行为",
      "不改区域名称文案"
    ],
    "verification_plan": [
      "DOM 几何断言：区域名称左边界不得小于圆点右边界，允许 2-4px 间距",
      "用北京市、天津市、石家庄市、沈阳市等长名称验证标签完整可见",
      "运行 tracking 相关测试、目标文件 ESLint、type-check、Vite build"
    ],
    "rollback_plan": [
      "revert 本次 CSS 候选提交，恢复简单 marker 原有标签位置"
    ],
    "data_access": false
  },
