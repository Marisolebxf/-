  "diagnosis": {
    "symptom": "科创政策全景把政策来源选成地方政策时，结果几乎等于全部来源。",
    "reproduction": [
      "打开科创政策全景政策检索",
      "政策来源选地方政策",
      "命中数接近未筛选的全量"
    ],
    "root_cause": "scope=local 的条件是层级白名单或省/市/区任一非空。国内政策几乎都有行政区，所以地方政策约 20235 条，全量约 20270 条。",
    "counter_evidence": [
      "scope=national 只等于 rank=国家级",
      "现有测试 test_scope_local_whitelist_and_admin_columns 锁住了行政区非空这段 OR"
    ],
    "requirement_refs": [
      "agent-delivery/工程过程/04-系统集成/05-展示系统集成/测试用例/POL-L2-DS10-QRY-FE-DISP-L01-验收用例.md#检索条件条下拉变化后触发 search"
    ],
    "impact_scope": [
      "lumen-algo-py polan.search.scope_clause 的 local 分支",
      "科创政策全景政策来源=地方政策"
    ]
  },
  "plan": {
    "change_scope": [
      "scope=local 只保留 rank 属于省级、市级、区县级、区级，去掉省/市/区非空的 OR"
    ],
    "non_goals": [
      "不改国家政策和海外政策的条件",
      "不改适用地区的行政区匹配",
      "不改前端文案"
    ],
    "verification_plan": [
      "test_scope_local_whitelist_and_admin_columns 改为断言地方条件不含 province/city/district",
      "相邻的 national/overseas/all 测试仍通过"
    ],
    "rollback_plan": [
      "在 lumen-algo-py revert 本次 local 条件提交"
    ],
    "data_access": false
  },
