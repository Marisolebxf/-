  "diagnosis": {
    "symptom": "全球创新监测-创新监测与分析-创新价值评估表格中，“影响潜力”和“成熟度”两列大面积显示缺测。",
    "reproduction": [
      "进入全球创新监测/创新监测与分析",
      "打开创新点详情中的创新价值评估",
      "查看模型候选项表格",
      "影响潜力、成熟度列基本为空"
    ],
    "root_cause": "算法库真实结果同时包含 top 与 comparable_top。前端当前直接对所有 candidates 按 value_score 截前10，单维新颖性候选因 value_score=100 大量占据主表，把具有成熟度或影响潜力的二维候选挤出；因此不是全无数据，而是候选选择未考虑维度覆盖。影响潜力在专利侧仍受血缘限制，但论文关键词存在真实影响潜力值，二维候选可如实展示，不应补 0。",
    "counter_evidence": [
      "M_INNOV_POINT_VALUE precompute 中 ipc4 有 13 个 n_with_maturity 候选，keyword_patent 有 353 个，keyword_paper 有 2 个 n_with_influence 候选",
      "当前接口 candidates 中可筛出 10 个以上至少两维可算的真实候选",
      "影响潜力专利侧缺测是算法自评“部分支持”的真实限制，不能通过前端伪造"
    ],
    "requirement_refs": [
      "agent-delivery/bid-reference/srs/02-科技信息展示系统/科技发展态势/全球创新监测.md#序号79 创新价值评估",
      "agent-delivery/bid-reference/科技信息展示系统和科技专题服务系统.md#1.1.1.1.4.1.4.5.3 创新价值评估"
    ],
    "impact_scope": [
      "lumen-ui-science-pc 全球创新监测-创新监测与分析-创新价值评估候选表",
      "模型候选排序展示与支撑度说明"
    ]
  },
  "plan": {
    "change_scope": [
      "新增零依赖创新价值候选筛选 helper，统计候选可用维数",
      "创新价值评估主表优先展示至少两维可算的真实候选，并更新说明文案",
      "补充单维高分候选不得挤占二维候选的回归自检"
    ],
    "non_goals": [
      "不修改算法库 value_score 或数据口径",
      "不伪造影响潜力/成熟度数值",
      "不修改后端接口",
      "不扩展到其他创新监测模块"
    ],
    "verification_plan": [
      "node --experimental-strip-types src/views/situation/global-innovation/innovationMonitor.test.mjs",
      "npm run type-check",
      "npm run build-only"
    ],
    "rollback_plan": [
      "回退本缺陷 fix 分支上的前端提交，恢复原有 topCandidates 选取逻辑"
    ],
