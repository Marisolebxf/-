  "diagnosis": {
    "symptom": "政策效果推演：新出台政策效果预测、历史政策效果板块的短期/长期效果无数据（P1，工单仅截图无步骤）",
    "reproduction": [
      "打开 政策效果推演 页（src/views/policy/simulation）",
      "新出台政策效果预测 / 历史政策效果：执行推演后查看短中长期效果区块",
      "现象：短期与长期效果无数据（截图 2026-11-13 工单附件）"
    ],
    "root_cause": "前端解析分支缺失：灌数端 lumen-algo-py mockgen/simulation.py 直写竖线格式「短期|2.5|2.6|5；中期|…；长期|…」「名称|85|良好；…」，而 simulationLive.mjs 的 termKpiItems/similarPolicyItems 在 01e86b2（去重重构）时误删竖线解析分支，导致该格式落空返回 []，短/长期效果卡无数据；非数据侧缺数",
    "counter_evidence": [
      "灌数端 gapfill_policy_sim_result 的 term_kpi_text / similar_policies_text 竖线格式文本非空（mockgen 直写），数据在库",
      "自检闭集断言：竖线格式经恢复后的解析器输出 3 期 KPI / 2 条政策，修复前同输入落空"
    ],
    "requirement_refs": [
      "POL-L2-DS12-WIRING-L01"
    ],
    "impact_scope": [
      "src/views/policy/simulation/simulationLive.mjs"
    ]
  },
  "plan": {
    "change_scope": [
      "ui_pc:src/views/policy/simulation/simulationLive.mjs"
    ],
    "non_goals": [
      "不改灌数端格式（后端为真源）",
      "不动 Java/Python 链路",
      "不加新依赖"
    ],
    "verification_plan": [
      "node src/views/policy/simulation/simulationLive.test.mjs（含竖线用例条件闭集自检）",
      "pnpm type-check（vue-tsc --build 全仓 0 error）",
      "K8s dev 页面复核：新出台预测→运行预测→短中长期效果卡出 3 枚 KPI"
    ],
    "rollback_plan": [
      "git revert 8fff84b 单提交回退，无数据/schema 变更"
    ],
