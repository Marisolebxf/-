  "diagnosis": {
    "symptom": "技术发展跟踪结果页切换到地理分布图后，点击图例中的技术类型复选框只改变图例状态，地图点位没有可见变化。",
    "reproduction": [
      "进入技术发展跟踪结果页",
      "切换到地理分布图展示",
      "逐个取消/勾选当前勾选技术类型",
      "地图点位和点位技术类型颜色未随选择变化"
    ],
    "root_cause": "Vue 版 ResultDashboard 的 mapPoints 迁自 demo 时丢失了图例启用态到点位颜色的映射，也没有按 selectedMapTechnologyTypeKeys 对 mapRegions 做前端即时过滤。后端虽按“区域技术类型与选中集合有交集”过滤，但同一区域通常包含多个技术类型，减少一个选中项时区域集合可能完全不变；同时点位 HTML 固定使用默认蓝色，因此用户看到筛选无反应。",
    "counter_evidence": [
      "后端 TrackingController 已按 selectedMapTechnologyTypeKeys 过滤区域，不是完全未接线",
      "mock/tracking 已有交集过滤测试，说明数据集层基础筛选逻辑存在",
      "TiandituMap 会按 points 渲染 key 重绘，但当前点位内容未体现所选技术类型"
    ],
    "requirement_refs": [
      "agent-delivery/bid-reference/科技信息展示系统和科技专题服务系统.md#1.1.1.1.4.1.3.1.2 地理分布图展示：支持图例筛选不同技术类型"
    ],
    "impact_scope": [
      "lumen-ui-science-pc 技术发展跟踪结果页地理分布图",
      "图例技术类型选择与地图点位可视化映射"
    ]
  },
  "plan": {
    "change_scope": [
      "新增零依赖地图技术类型筛选/主类型解析 helper",
      "ResultDashboard 地图点位按选中技术类型即时过滤，并使用主类型颜色和类型标识生成点位 key",
      "补充技术类型筛选与主类型颜色切换的回归自检"
    ],
    "non_goals": [
      "不修改后端区域聚合口径",
      "不修改数据库或制造 Mock 数据",
      "不扩展到其他地图页面",
      "不改变需规和验收标准"
    ],
    "verification_plan": [
      "node --experimental-strip-types src/views/situation/tracking/tracking.test.mjs",
      "npm run type-check",
      "npm run build-only"
    ],
    "rollback_plan": [
      "仅回退本缺陷 fix 分支上的前端提交；不改共享 dev 历史",
      "若地图点位异常，恢复 ResultDashboard 原 mapPoints/onMapPointClick 实现并保留后端既有过滤"
    ],
