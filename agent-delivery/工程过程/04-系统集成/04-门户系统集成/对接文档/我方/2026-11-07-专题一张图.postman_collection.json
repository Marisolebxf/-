{
  "info": {
    "name": "门户专题一张图",
    "description": "智慧服务门户「专题一张图」6 个接口。Base URL 已含调用地址，路径直接接在后面。导入 Apifox 或 Postman 后，把集合变量 token 换成统一用户中心签发的访问令牌。说明见同目录《2026-11-06-专题一张图-外部对接接口文档.md》v1.2。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://10.50.69.111:30895/topic/v1/portal/one-map"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 产业维度统计",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"industry_code\": \"INB1309\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/industry-stats",
        "description": "产业页签。industry_code 必填。scale 无数据时 value 为 null，scale_trend 为 []。"
      },
      "response": [
        {
          "name": "成功",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"industry_code\": \"INB1309\"\n}"
            },
            "url": "{{baseUrl}}/industry-stats"
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"code\": 0,\n  \"msg\": null,\n  \"data\": {\n    \"scale\": { \"value\": null, \"unit\": \"亿元\", \"metric_id\": \"M_ONE_MAP_INDUSTRY_SCALE\" },\n    \"scale_trend\": [],\n    \"org_count\": { \"value\": 1280, \"unit\": \"家\", \"metric_id\": \"M_ENT_REGIONAL_COUNT_TOPIC\" },\n    \"org_count_trend\": [\n      { \"year\": 2023, \"value\": 1100 },\n      { \"year\": 2024, \"value\": 1280 }\n    ]\n  }\n}"
