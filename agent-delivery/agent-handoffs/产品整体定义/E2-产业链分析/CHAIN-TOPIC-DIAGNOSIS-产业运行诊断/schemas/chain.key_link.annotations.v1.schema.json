{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gkx-lumen.local/schemas/chain/key_link/annotations.v1.json",
  "title": "ChainKeyLinkAnnotationsV1",
  "description": "关键环节 Result：payload.sections.annotations。每个 is_key_node=true 的环节必须有一条依据；数字须能在 chain_structure / scores 事实中找到。禁止无证据补造关键。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {
      "const": "chain.key_link.annotations.v1"
    },
    "items": {
      "type": "array",
      "description": "建议仅含关键环节；允许空数组仅当全链无关键（罕见，须与 summary.key_node_count=0 一致）。",
      "items": { "$ref": "#/$defs/AnnotationItem" }
    }
  },
  "$defs": {
    "StageKey": {
      "type": "string",
      "enum": ["rd", "design", "manufacturing", "sales", "service"]
    },
    "AnnotationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_key",
        "reason_codes",
        "reason_text",
        "rule_pack_version"
      ],
      "properties": {
        "stage_key": { "$ref": "#/$defs/StageKey" },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "description": "机器码，如 enterprise_count_top_pct"
          }
        },
        "reason_text": {
          "type": "string",
          "minLength": 1,
          "description": "人读依据；所含数字必须来自已算事实"
        },
        "rule_pack_version": {
          "type": "string",
          "minLength": 1,
          "description": "与 Input.rules.rule_pack_version 一致，便于单结果自证"
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "可选证据快照 id"
        }
      }
    }
  }
}
