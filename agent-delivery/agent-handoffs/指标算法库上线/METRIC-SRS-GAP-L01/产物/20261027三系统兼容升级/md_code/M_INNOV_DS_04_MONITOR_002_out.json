 "quarantine_delta": {
  "why": "隔离前旧稿读 20261020 共享 bundle（演示库 + 2017—2020 补零），且成熟度用 `kind IN ('B','U')` 近似授权、被引直接取 bundle 值",
  "old_vs_new": [
   {
    "item": "打分词条数",
    "old": 30,
    "new": 33,
    "cause": "旧稿只取 bundle 的 Top30 切片；本件对全部 33 个候选逐条打分"
   },
   {
    "item": "value_min",
    "old": 16.7,
    "new": 0.0,
    "cause": "候选集与成熟度口径同时变化"
   },
   {
    "item": "value_max",
    "old": 66.3,
    "new": 67.8,
    "cause": "同上；旧稿最高分来自 C07K14/015（首现 2022 的新颖性优势）"
   },
   {
    "item": "被引为 0 的候选占比",
    "old": 1.0,
    "new": null,
    "cause": "本件不把「被引不可连」写成 0，而是标为缺测并不参与权重"
   },
   {
    "item": "新颖性取值个数",
    "old": 2,
    "new": 3,
    "cause": "旧稿候选首现年只有 2021/2022；本件含 2023 年首现（B60V）"
   }
  ]
 },
 "support_judgment": "部分支持",
 "support_basis": "候选集（33 条）与新颖性（t0 全量 IPC 面板）是逐件实测；成熟度只能按「申请人在其各 IPC 上授权率一致」的分摊法估算（全表两侧，合计可复核）；影响潜力在词条层不可算（被引表 pn 与专利主表连通率 2.28%，且落不到候选 IPC 上），故合成分是二维重归一，不是王惠三维等权原式——按「始终有部分依赖维拿不到数据」判部分支持。",
 "reasons": [
  "新颖性可算但被库内年份截断：t0 最小 2021，故 1/(1+T−t0) 只能取 0.25/0.333/0.5 三档，不是连续量，排名分辨率低；",
  "影响潜力缺测：dwd_patent_cited 仅 20,515 行（占专利 0.70%），其中 467 个 pn 能连回主表（2.28%），词条级被引合计无法闭合；",
  "成熟度为分摊估算：逐件授权号在 granted_number 上有，但按 IPC 聚合需对 294 万行无索引表 GROUP BY（§3.6 禁止），只能用「申请人授权率 × 该 IPC 件数」分摊，全量合计 1,660,716 件、对应授权率 68.60%，与全表 72.81% 差 4.21 个百分点（无 IPC 的 51.9 万件未进分母）；",
  "论文侧被引可算（20,031 篇全部有值、最大 670），但论文关键词只有 2 个候选，不能把「影响潜力」这一维从专利侧挪到论文侧补足；",
  "三维权重王惠原文只写「加权平均」未给具体权重，本件取等权并在 params 里写明，属口径假设。"
 ],
 "notes": [
  "本脚本零 SQL、无 reused_from；候选集在本脚本内独立复算，与 MONITOR_001 同一口径。",
  "value_score 的绝对高低不可跨批次比较：min-max 是在 33 条候选内做的。",
  "成熟度是估算值，`granted_est` 与 `maturity_est` 必须与 `is_estimate=true` 一起展示。",
  "不要把本件的 value_score 当作「创新点价值排名」对外发布：它只用了两维，影响潜力维缺失会让高被引的老词条系统性偏低。"
 ]
}